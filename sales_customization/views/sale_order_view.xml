<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="sale_order_form_multi_pet_on_order" model="ir.ui.view">
        <field name="name">sale.order.form.multi.pet.on.order</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[1]" position="inside">
                <group name="pets_group" string="Pets">
                    <field name="pet_ids"
                           widget="many2many_tags"
                           options="{'no_create': true, 'no_create_edit': true}"
                           placeholder="Select or search pets..."/>
                </group>
            </xpath>

            <xpath expr="//field[@name='order_line']/list/field[@name='product_id']" position="attributes">
                <attribute name="domain">product_domain</attribute>
            </xpath>
        </field>
    </record>

</odoo>
